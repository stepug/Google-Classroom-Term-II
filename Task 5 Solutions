#include <stdio.h>
#include <math.h>

void calculateLoanPayment() {
    float principal = 50000000, annualRate = 0.05, monthlyRate, months = 60, monthlyPayment;
    monthlyRate = annualRate / 12;
    monthlyPayment = (principal * monthlyRate * pow(1 + monthlyRate, months)) / (pow(1 + monthlyRate, months) - 1);
    printf("Monthly loan payment: UGX %.2f\n", monthlyPayment);
}

int main() {
    calculateLoanPayment();
    return 0;
}
