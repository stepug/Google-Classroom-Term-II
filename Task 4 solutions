int main() {
    float amount, tax, total;

    printf("Enter purchase amount: ");
    scanf("%f", &amount);

    if (amount < 500)
        tax = amount * 0.05;
    else
        tax = amount * 0.08;

    total = amount + tax;
    printf("Total payable amount: %.2f\n", total);
    return 0;
}
