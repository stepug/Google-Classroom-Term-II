#include <stdio.h>

int main() {
    int years;
    float fee, finalFee;

    printf("Enter membership duration (years): ");
    scanf("%d", &years);
    printf("Enter total fee: ");
    scanf("%f", &fee);

    if (years >= 4)
        finalFee = fee * 0.9;
    else if (years >= 1)
        finalFee = fee * 0.95;
    else
        finalFee = fee;

    printf("Final fee to be paid: %.2f\n", finalFee);
    return 0;
}
