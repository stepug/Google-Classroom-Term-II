#include <stdio.h>

int main() {
    float cp, sp;

    printf("Enter cost price: ");
    scanf("%f", &cp);
    printf("Enter selling price: ");
    scanf("%f", &sp);

    if (sp > cp)
        printf("Profit: %.2f\n", sp - cp);
    else if (sp < cp)
        printf("Loss: %.2f\n", cp - sp);
    else
        printf("No profit or loss.\n");

    return 0;
}
